# ──────────────────────────────────────────────────────────────────────────────
# Travel Planner API — Environment Variables
# Copy this file to .env and fill in your keys.
# ──────────────────────────────────────────────────────────────────────────────

# ── Amadeus (Hotel search) ────────────────────────────────────────────────────
# Free signup: https://developers.amadeus.com → Self-Service → Create App
# Sandbox (test) keys work immediately; production needs approval (1–2 days)
# AMADEUS shut down self-service July 2026. Use Nuitee Connect instead.
NUITEE_API_KEY=
AMADEUS_CLIENT_SECRET=
# Set to "production" after approval; default is "test" (sandbox)
AMADEUS_ENV=test

# ── OpenTripMap (Points of Interest) ─────────────────────────────────────────
# No longer used — replaced by Overpass API (OpenStreetMap), which is free with no key
# OPENTRIPMAP_API_KEY=  <-- not needed, replaced by OpenStreetMap Overpass API

# ── Open-Meteo (Weather) ──────────────────────────────────────────────────────
# No API key required. Free & unlimited for non-commercial use.

# ── erail.in Train Scraper ────────────────────────────────────────────────────
# No API key required. Uses public web scraping.

# ── Optional: Google Places + Routes ─────────────────────────────────────────
# For richer POI data and drive-time calculations
# Enable Maps Platform at: https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=

# ── Optional: Cache (Redis) ───────────────────────────────────────────────────
# TTL rules: Hotel rates 5min | POI 30 days | Routes 90 days | Weather 3h
REDIS_URL=redis://localhost:6379

# ── App settings ──────────────────────────────────────────────────────────────
PORT=8000
